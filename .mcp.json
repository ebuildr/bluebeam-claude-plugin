{
  "mcpServers": {
    "bluebeam": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/mcp.mjs"],
      "env": {
        "BLUEBEAM_CLIENT_ID": "${user_config.client_id}",
        "BLUEBEAM_CLIENT_SECRET": "${user_config.client_secret}",
        "BLUEBEAM_REGION": "${user_config.region}",
        "BLUEBEAM_REDIRECT_URI": "${user_config.redirect_uri}"
      }
    }
  }
}
